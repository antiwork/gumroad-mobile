+package com.github.barteksc.pdfviewer;
+
+import java.util.concurrent.CountDownLatch;
+
+public final class RenderingDrain {
+    private RenderingDrain() {}
+
+    public static void stopAndWait(PDFView view) {
+        RenderingHandler handler = view.renderingHandler;
+        if (handler == null) {
+            return;
+        }
+
+        Thread renderer = handler.getLooper().getThread();
+        if (renderer == Thread.currentThread()) {
+            throw new IllegalStateException("Cannot recycle a PDF from its rendering thread");
+        }
+
+        handler.stop();
+        handler.removeMessages(RenderingHandler.MSG_RENDER_TASK);
+        CountDownLatch drained = new CountDownLatch(1);
+        boolean posted = handler.post(drained::countDown);
+        boolean interrupted = false;
+        try {
+            while (true) {
+                try {
+                    // Removing queued work cannot stop a native render already using the document.
+                    // Never close on a timeout or interrupt while that render can still be running.
+                    if (posted) {
+                        drained.await();
+                    } else {
+                        renderer.join();
+                    }
+                    return;
+                } catch (InterruptedException exception) {
+                    interrupted = true;
+                }
+            }
+        } finally {
+            if (interrupted) {
+                Thread.currentThread().interrupt();
+            }
+        }
+    }
+}
